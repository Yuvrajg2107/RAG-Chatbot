# No API key is needed for local evidence mode.
# To generate answers, create a Gemini API key in Google AI Studio.
# Never commit your real .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local sentence embeddings; first use downloads model weights (~67 MB).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Similarity gate is a heuristic, not a confidence probability.
RETRIEVAL_THRESHOLD=0.62
DATA_DIR=data
# Set true only behind HTTPS. This application is a single-instance local demo.
COOKIE_SECURE=false
